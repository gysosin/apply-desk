# Copy to app/.env (never commit it). Leave everything commented out to use your Claude subscription login.

# Option A: Anthropic API key (pay per use, no subscription needed)
# ANTHROPIC_API_KEY=sk-ant-...

# Option B: long-lived token from your Claude subscription (`claude setup-token`)
# CLAUDE_CODE_OAUTH_TOKEN=...

# Timezone the scheduler uses
# TZ=Asia/Kolkata
